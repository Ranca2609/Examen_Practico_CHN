# ============================================================================
#  Variables de entorno del Sistema de Gestión de Préstamos — CHN
#
#  Copia este archivo como .env y sustituye TODOS los valores antes de
#  desplegar fuera del entorno de examen:
#      cp .env.example .env
#
#  El archivo .env NO se versiona (ver .gitignore). Si no existe, Docker
#  Compose usa los valores de demostración definidos en docker-compose.yml,
#  lo que permite levantar el entorno con un único comando.
# ============================================================================

# --- Base de datos ---------------------------------------------------------
# Contraseña del usuario administrador (sa) del motor SQL Server.
# Requisitos de SQL Server: mínimo 8 caracteres con mayúsculas, minúsculas,
# dígitos y símbolos.
MSSQL_SA_PASSWORD=Chn#Sa2026Demo
DB_NAME=CHN_Prestamos
# Usuario de aplicación con privilegios mínimos (db_owner SOLO de esta base).
# El backend nunca se conecta como sa.
DB_USER=chn_app
DB_PASSWORD=Chn#App2026Demo

# --- Seguridad de la API ---------------------------------------------------
# Secreto de firma de los tokens JWT (HMAC-SHA256). Mínimo 32 caracteres.
# Genéralo aleatoriamente, por ejemplo:  openssl rand -base64 48
JWT_SECRET=clave-demo-chn-prestamos-2026-cambiar-en-produccion
# Vigencia del token en minutos (480 = 8 horas, una jornada laboral).
JWT_EXPIRACION_MINUTOS=480
# Lista blanca de orígenes autorizados para CORS, separados por coma.
CORS_ORIGENES=http://localhost:8080,http://localhost:5173

# --- Usuarios iniciales ----------------------------------------------------
# Se crean al arrancar si no existen, con la contraseña cifrada en BCrypt.
# Cámbialas de inmediato en cualquier entorno real.
ADMIN_PASSWORD=Chn2026*Demo
ANALISTA_PASSWORD=Chn2026*Demo
CAJERO_PASSWORD=Chn2026*Demo
CONSULTA_PASSWORD=Chn2026*Demo

# --- Datos de demostración -------------------------------------------------
# true  -> Flyway carga además el juego de datos de prueba (database/demo).
# false -> solo esquema y parámetros; la base queda vacía de clientes.
APP_DATOS_DEMO=true

# --- Numeración oficial de documentos --------------------------------------
# Agencia emisora (3 dígitos) que viaja en cada número: SC-001-2026-000001-3.
APP_CODIGO_AGENCIA=001

# --- Publicación de puertos en el host -------------------------------------
WEB_PUERTO_HOST=8080
API_PUERTO_HOST=8081
DB_PUERTO_HOST=1433
