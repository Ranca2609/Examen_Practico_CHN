# ---------------------------------------------------------------------------
# Variables de entorno del frontend (copiar como .env para uso local).
# Solo las variables con prefijo VITE_ llegan al navegador: NUNCA se debe poner
# aquí una contraseña, una llave o un secreto, porque quedan visibles en el bundle.
# ---------------------------------------------------------------------------

# URL base de la API.
#
# Desarrollo: se deja el valor relativo "/api/v1" y el proxy de vite.config.js
#             reenvía las peticiones a http://localhost:8081, evitando CORS.
#
# Producción (Docker): nginx sirve el sitio y hace proxy de "/api" hacia el
#             contenedor del backend, por lo que el valor relativo también funciona.
#
# Solo hay que cambiarlo si el backend se publica en otro dominio,
# por ejemplo: VITE_API_URL=https://api.ejemplo.gt/api/v1
VITE_API_URL=/api/v1
